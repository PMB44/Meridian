// Copy this file to Secrets.xcconfig in the same folder. Secrets.xcconfig is gitignored.
// Never put an Anthropic key here. The app never holds one.

// Apple Developer Team ID (10 characters). Found at developer.apple.com under Membership.
DEVELOPMENT_TEAM =

// Supabase project host without https://, for example abcdefgh.supabase.co
SUPABASE_HOST =

// Supabase anon (publishable) key. Not the service role key.
SUPABASE_ANON_KEY =
